# AMLGuard configuration. Copy to `.env` and fill in the required values.
# Real environment variables always win over this file (env.py loads it as defaults).
# The authoritative list of every setting the code reads is src/amlguard/settings.py.

# ── Protegrity Developer Edition credentials (REQUIRED for ingest) ─────────────
# Register free at https://www.protegrity.com/developers/dev-edition-api
DEV_EDITION_EMAIL=you@example.com
DEV_EDITION_PASSWORD=
DEV_EDITION_API_KEY=

# ── Protegrity local services (optional overrides; defaults assume local Docker) ─
# AMLGUARD_DISCOVERY_URL=http://localhost:8580/pty/data-discovery/v2/classify/text
# AMLGUARD_DISCOVERY_THRESHOLD=0.6      # min discovery score to treat a span as an entity
# AMLGUARD_DISCOVERY_WORKERS=4          # parallel discovery workers during ingest
# AMLGUARD_GUARDRAIL_URL=http://localhost:8581/pty/semantic-guardrail/v1.1/conversations/messages/scan

# ── Models / LLM ──────────────────────────────────────────────────────────────
# AMLGUARD_MODEL=bedrock-sonnet-5       # default model (else config/models.yaml default)
# OLLAMA_URL=http://localhost:11434     # local Ollama endpoint. Unset: localhost on a host, or the
#                                       #   host's Ollama (host.docker.internal) inside a container.
# AMLGUARD_IN_CONTAINER=                 # set to 1 by the Docker image; only flips the OLLAMA_URL
#                                       #   default to host.docker.internal. Leave unset on a host.
AMLGUARD_MAX_SPEND_USD=5.0              # hard ceiling for hosted inference, enforced pre-call
# AMLGUARD_LLM_TIMEOUT=120               # per-request LLM timeout (s); low for interactive serving
# ANTHROPIC_API_KEY=                    # required only for the anthropic provider
# OPENAI_API_KEY=                       # required only for the openai provider
# AWS_DEFAULT_REGION=us-east-1          # required only for the bedrock provider
#
# Live-chat model selection (so a fork runs WITHOUT cloud credentials). Precedence:
#   1) AMLGUARD_UI_MODEL if set  2) the hosted model when AWS creds are present  3) the local model.
# AMLGUARD_UI_MODEL=                     # force a specific config/models.yaml model for live chat
# AMLGUARD_HOSTED_MODEL=bedrock-sonnet-5 # hosted model used when AWS credentials are present
# AMLGUARD_LOCAL_MODEL=llama3.2          # open-source Ollama model used when there are no cloud creds
# AMLGUARD_AUTO_PULL_MODEL=false         # true = pull the local model on first use (one-time setup);
#                                        #   otherwise run `make setup-local-model` once yourself

# ── Observability (all optional; each plane degrades to a no-op if absent) ──────
# AMLGUARD_MLFLOW_URI=http://localhost:5001
# AMLGUARD_MLFLOW_STORE_DIR=                # local MLflow store dir; default observability/mlflow/store
# AMLGUARD_POSTGRES_URL=postgresql://amlguard:amlguard@localhost:5433/amlguard  # app corpus mirror (Postgres)
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_TIMEOUT=20                    # seconds; raise for a cold self-hosted stack
# AMLGUARD_PUSHGATEWAY=localhost:9093    # Prometheus Pushgateway for ingest metrics (write side)
# AMLGUARD_PROMETHEUS_URL=http://localhost:9092  # Prometheus query API (read side; observability_report)
# AMLGUARD_LOG_LEVEL=INFO

# ── Telemetry kill switches (set to 1 to disable that plane) ────────────────────
# AMLGUARD_NO_TRACKING=1                 # disable MLflow
# AMLGUARD_NO_TRACING=1                  # disable Langfuse
# AMLGUARD_NO_METRICS=1                  # disable Prometheus push

# ── Misc ──────────────────────────────────────────────────────────────────────
# DOTENV_PATH=/abs/path/to/.env         # explicit .env location (else nearest is used)
# AMLGUARD_ANONYMIZATION_URL=http://localhost:8085/pty/anonymization/v3
# AMLGUARD_SYNTHETIC_URL=http://localhost:8000/pty/syntheticdata/v2
# AMLGUARD_UI_API_BASE=http://localhost:8600
# AMLGUARD_UI_API_TOKEN=                  # shared secret guarding the PAID /api/chat/turn; unset = open on loopback
# AMLGUARD_UI_MAX_TURNS=200               # per-process ceiling on live (billed) chat turns; 0 disables

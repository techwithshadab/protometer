# Protometer configuration. Copy to `.env` and fill in the required values.
# Real environment variables always win over this file (env.py loads it as defaults).
# The authoritative list of every setting the code reads is src/protometer/settings.py.

# ── Protegrity Developer Edition credentials (REQUIRED for ingest) ─────────────
# Register free at https://www.protegrity.com/developers/dev-edition-api
DEV_EDITION_EMAIL=you@example.com
DEV_EDITION_PASSWORD=
DEV_EDITION_API_KEY=

# ── Protegrity local services (optional overrides; defaults assume local Docker) ─
# PROTOMETER_DISCOVERY_URL=http://localhost:6000/pty/data-discovery/v2/classify/text   # shared DE tier (in-container: pty-classification:8050)
# PROTOMETER_DISCOVERY_THRESHOLD=0.6      # min discovery score to treat a span as an entity
# PROTOMETER_DISCOVERY_WORKERS=4          # parallel discovery workers during ingest
# PROTOMETER_GUARDRAIL_URL=http://localhost:6001/pty/semantic-guardrail/v1.1/conversations/messages/scan   # shared DE tier (in-container: pty-guardrail:8001)

# ── Models / LLM ──────────────────────────────────────────────────────────────
# PROTOMETER_MODEL=bedrock-sonnet-5       # default model (else config/models.yaml default)
# OLLAMA_URL=http://localhost:11434     # local Ollama endpoint. Unset: localhost on a host, or the
#                                       #   host's Ollama (host.docker.internal) inside a container.
# PROTOMETER_IN_CONTAINER=                 # set to 1 by the Docker image; only flips the OLLAMA_URL
#                                       #   default to host.docker.internal. Leave unset on a host.
PROTOMETER_MAX_SPEND_USD=5.0              # hard ceiling for hosted inference, enforced pre-call
# PROTOMETER_LLM_TIMEOUT=120               # per-request LLM timeout (s); low for interactive serving
# ANTHROPIC_API_KEY=                    # required only for the anthropic provider
# OPENAI_API_KEY=                       # required only for the openai provider
# AWS_REGION=us-east-1                  # bedrock region; checked first, then AWS_DEFAULT_REGION
# AWS_DEFAULT_REGION=us-east-1          # required only for the bedrock provider
#
# Live-chat model selection (so a fork runs WITHOUT cloud credentials). Precedence:
#   1) PROTOMETER_UI_MODEL if set  2) the hosted model when AWS creds are present  3) the local model.
# PROTOMETER_UI_MODEL=                     # force a specific config/models.yaml model for live chat
# PROTOMETER_HOSTED_MODEL=bedrock-sonnet-5 # hosted model used when AWS credentials are present
# PROTOMETER_LOCAL_MODEL=llama3.2          # open-source Ollama model used when there are no cloud creds
# PROTOMETER_AUTO_PULL_MODEL=false         # true = pull the local model on first use (one-time setup);
#                                        #   otherwise run `make setup-local-model` once yourself

# ── Observability (all optional; each plane degrades to a no-op if absent) ──────
# PROTOMETER_MLFLOW_URI=http://localhost:5001
# PROTOMETER_MLFLOW_STORE_DIR=                # local MLflow store dir; default observability/mlflow/store
# PROTOMETER_POSTGRES_URL=postgresql://protometer:protometer@localhost:8001/protometer  # app corpus mirror (Postgres)
# Langfuse: shared v4 instance (observability-shared tier). Protometer's aml domain uses these default
# keys; healthcare/support fall back to their own LANGFUSE_*_HEALTHCARE / _SUPPORT keys below.
# Do NOT set LANGFUSE_HOST here: containers must use the compose default http://obs-langfuse:3000
# (an active LANGFUSE_HOST in .env overrides it and points the container at an unreachable host
# loopback). Host-side (bare-python) runs use settings.py's default http://127.0.0.1:5006. Only set
# LANGFUSE_HOST for a truly remote Langfuse. UI is on the host at http://127.0.0.1:5006.
# LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Per-domain isolation: healthcare and customer-support each trace into their OWN Langfuse project
# (own prompts + traces), so PII and prompt versions never mix across use cases. Create the
# "Healthcare" and "Customer Support" projects once in the Langfuse UI (org "Protegrity"; the
# provisioning API is Enterprise-only) and paste their keys here. If unset, both fall back to the
# default LANGFUSE_*_KEY above (the aml project) — correct for a single-domain demo, but then the
# three domains share one project.
# LANGFUSE_PUBLIC_KEY_HEALTHCARE=pk-lf-...
# LANGFUSE_SECRET_KEY_HEALTHCARE=sk-lf-...
# LANGFUSE_PUBLIC_KEY_SUPPORT=pk-lf-...
# LANGFUSE_SECRET_KEY_SUPPORT=sk-lf-...
# LANGFUSE_TIMEOUT=20                    # seconds; raise for a cold self-hosted stack
# PROTOMETER_PUSHGATEWAY=localhost:5004    # Prometheus Pushgateway for ingest metrics (write side)
# PROTOMETER_PROMETHEUS_URL=http://localhost:5003  # Prometheus query API (read side; observability_report)
# PROTOMETER_LOG_LEVEL=INFO

# ── Telemetry kill switches (set to 1 to disable that plane) ────────────────────
# PROTOMETER_NO_TRACKING=1                 # disable MLflow
# PROTOMETER_NO_TRACING=1                  # disable Langfuse
# PROTOMETER_NO_METRICS=1                  # disable Prometheus push

# ── Misc ──────────────────────────────────────────────────────────────────────
# DOTENV_PATH=/abs/path/to/.env         # explicit .env location (else nearest is used)
# PROTOMETER_ANONYMIZATION_URL=http://localhost:6004/pty/anonymization/v3   # shared DE tier (in-container: pty-anon:8085)
# PROTOMETER_SYNTHETIC_URL=http://localhost:6005/pty/syntheticdata/v2       # shared DE tier (in-container: pty-synthetic:8000)
# PROTOMETER_UI_API_BASE=http://localhost:8000   # browser-facing UI base (app binds container :8600, published to host :8000)
# PROTOMETER_UI_API_TOKEN=                  # shared secret guarding the PAID /api/chat/turn; unset = open on loopback
# PROTOMETER_UI_MAX_TURNS=200               # per-process ceiling on live (billed) chat turns; 0 disables

# ── Detokenization defenses (optional) ──────────────────────────────────────
# Bind role to the caller's token instead of trusting the request body. Format:
# role:token pairs, comma-separated. Unset = the request's role is used (local-demo default).
# PROTOMETER_UI_ROLE_TOKENS=auditor:tok-a,investigator:tok-i
# Where the hash-chained reveal ledger is written (default: beside the MLflow store).
# PROTOMETER_REVEAL_LEDGER=/path/to/reveal_ledger.jsonl

# BOTOX Information Assistant: configuration. Copy to .env; all values have working defaults.

# ── Graph store ──────────────────────────────────────────────────────────────
NEO4J_PASSWORD=botoxdemo123

# ── Reasoning model (precedence: BOTOX_MODEL > hosted-if-creds > local Ollama) ─
# Leave blank to auto-select. Local default is llama3.2 via Ollama ($0, no cloud account).
BOTOX_MODEL=
BOTOX_LOCAL_MODEL=llama3.2
OLLAMA_URL=http://host.docker.internal:11434
# For a HOSTED model, set one of these (a real billed call each turn):
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── PII protection (user-side): PROTEGRITY IS REQUIRED ───────────────────────
# There is NO mock and NO regex fallback. Detection uses Protegrity Discovery (local) and
# tokenization uses the appython SDK against hosted Data Protection. If these are not reachable the
# bot fails closed: /api/health reports not-ready and every turn refuses (no unprotected PII flows).
# Local Data Discovery service (ML/NER PII detection). Point at your DE discovery endpoint.
PROTEGRITY_DISCOVERY_URL=
PROTEGRITY_DISCOVERY_THRESHOLD=0.6
# Hosted tokenization credentials (appython SDK).
DEV_EDITION_EMAIL=
DEV_EDITION_PASSWORD=
DEV_EDITION_API_KEY=
# Optional: policy user + session lifetime for the tokenization session (defaults: superuser / 30m).
# PROTEGRITY_POLICY_USER=superuser
# PROTEGRITY_SESSION_MINUTES=30

# Role-gated re-identification (/api/support/reveal): a shared secret an internal support tool sends
# as `Authorization: Bearer <token>`. UNSET disables reveal entirely (the public chat path is always
# zero-reveal regardless). nginx blocks this path on the public frontend; reach it only on the
# backend loopback port. Set a strong, private value if you enable it.
SUPPORT_API_TOKEN=
# HMAC key for signing feedback trace-handles (anti-forgery on /api/feedback). Not a tokenization
# key; set a private value for real deployments.
BOTOX_TOKEN_KEY=botox-demo-deterministic-key

# ── Egress: Protegrity Semantic Guardrail (optional) ─────────────────────────
# Opt-in ML scan of the outbound reply, layered ON TOP of the always-on regex egress guard. Set to
# 'on' and point at your local Semantic Guardrail service to enable. It can only ADD a block (e.g.
# an identifier the regex missed); it never passes something the regex guard rejected.
PROTEGRITY_SEMANTIC_GUARD=
PROTEGRITY_SEMANTIC_GUARD_URL=

# ── Observability: Langfuse agent tracing (SHARED instance) ──────────────────
# Tracing goes to the SHARED Langfuse v4 (the `observability-shared` compose project, org
# "Protegrity"), NOT a bundled per-demo Langfuse. Bring it up first with `make shared-up` from the
# repo root. In-container the backend reaches it at obs-langfuse:3000; the UI is on the host at
# http://127.0.0.1:5006 (sign in: admin@protegrity.local / protegrity-admin).
#
# Botox traces into its OWN project ("Botox") so they never mix with Protometer's. Create that project
# ONCE in the Langfuse UI (the org/project provisioning API is Enterprise-only) and paste its keys
# here — they are read FIRST, ahead of any shared LANGFUSE_*_KEY, so botox traces stay isolated.
BOTOX_LANGFUSE_PUBLIC_KEY=
BOTOX_LANGFUSE_SECRET_KEY=
# Override only if the shared Langfuse is somewhere else (default obs-langfuse:3000 works in-compose).
LANGFUSE_HOST=
# Set BOTOX_TRACING=off to force-disable tracing even when keys are present.
BOTOX_TRACING=
#
# Bundled fallback ONLY: `docker compose --profile bundled up` runs a throwaway per-demo Langfuse
# instead of the shared one. These seed that instance's first user + internal secrets; they are
# ignored when you use the shared instance above. Change them for any non-local bundled use.
LANGFUSE_INIT_USER_EMAIL=admin@protegrity.local
LANGFUSE_INIT_USER_PASSWORD=protegrity-admin
LANGFUSE_DB_PASSWORD=langfuse-demo-pw
LANGFUSE_NEXTAUTH_SECRET=botox-demo-nextauth-secret-change-me
LANGFUSE_SALT=botox-demo-salt-change-me

# Frontend build/runtime configuration (all optional).

# Override the API base the browser calls. Defaults to "/api" (proxied by nginx/Vite to the
# backend). Set this only if the API is hosted at a different origin.
# VITE_API_BASE=/api

# Dev-only: where `vite dev` proxies /api to. Defaults to http://localhost:8000.
# VITE_API_PROXY_TARGET=http://localhost:8000

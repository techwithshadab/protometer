{
  "title": "AMLGuard Ingest Operations",
  "uid": "amlguard-ingest",
  "schemaVersion": 39,
  "editable": true,
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Ingest duration by scope (s)", "type": "barchart",
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
     "targets": [{"expr": "amlguard_ingest_seconds", "legendFormat": "{{scope}}"}]},
    {"id": 2, "title": "Discovery share of wall-clock (s)", "type": "barchart",
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
     "targets": [{"expr": "amlguard_ingest_seconds_in_discovery", "legendFormat": "{{scope}}"}]},
    {"id": 3, "title": "Protect API call rate (calls/s)", "type": "timeseries",
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
     "fieldConfig": {"defaults": {"thresholds": {"steps": [
        {"color": "green", "value": null}, {"color": "red", "value": 50}]}}},
     "targets": [{"expr": "amlguard_ingest_api_rate", "legendFormat": "{{scope}}"}]},
    {"id": 4, "title": "Entities found vs protected", "type": "barchart",
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
     "targets": [
       {"expr": "amlguard_ingest_entities_found", "legendFormat": "found {{scope}}"},
       {"expr": "amlguard_ingest_entities_protected", "legendFormat": "protected {{scope}}"}]},
    {"id": 5, "title": "No-ops + protection failures", "type": "stat",
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
     "fieldConfig": {"defaults": {"thresholds": {"steps": [
        {"color": "green", "value": null}, {"color": "orange", "value": 1}]}}},
     "targets": [
       {"expr": "sum(amlguard_ingest_noops)", "legendFormat": "no-ops"},
       {"expr": "sum(amlguard_ingest_failures)", "legendFormat": "failures"}]},
    {"id": 6, "title": "Token cache hit rate", "type": "gauge",
     "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16},
     "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}},
     "targets": [{"expr": "amlguard_ingest_cache_hit_rate", "legendFormat": "{{scope}}"}]},
    {"id": 7, "title": "Protect retries", "type": "stat",
     "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16},
     "targets": [{"expr": "sum(amlguard_ingest_retries)", "legendFormat": "retries"}]}
  ]
}

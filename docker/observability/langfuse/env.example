# Langfuse self-host secrets, copy to vendor/langfuse/.env and fill in.
# Generate: openssl rand -hex 32 (ENCRYPTION_KEY must be 64 hex chars).
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_SECRET=CHANGEME
REDIS_AUTH=CHANGEME
CLICKHOUSE_PASSWORD=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME   # = MINIO_ROOT_PASSWORD
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME   # = MINIO_ROOT_PASSWORD
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=CHANGEME   # = MINIO_ROOT_PASSWORD
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres
# Headless first-boot provisioning: org, project and API keys exist without touching the UI.
# The same keys go into this repo's .env as LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
LANGFUSE_INIT_ORG_ID=protometer
LANGFUSE_INIT_ORG_NAME=Protometer
LANGFUSE_INIT_PROJECT_ID=protometer-pipeline
LANGFUSE_INIT_PROJECT_NAME=protometer-pipeline
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=You
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
